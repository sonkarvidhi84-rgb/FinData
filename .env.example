# Copy to .env and fill in. Never commit .env.
# Warehouse: SQLite by default; set a postgresql+psycopg URL for "prod".
DATABASE_URL=
DATA_DIR=
# Contact string sent in User-Agent (SEC EDGAR / polite scraping)
CONTACT_EMAIL=
# FRED: optional, the keyless fredgraph CSV endpoint is used when empty
FRED_API_KEY=
# OpenFIGI: optional, raises rate limit from 25 to 250 req/min
OPENFIGI_API_KEY=
# data.gov.in (MOSPI) - not used yet
DATA_GOV_IN_API_KEY=
# Alpha Vantage / Twelve Data / Finnhub - not used yet (backup price sources)
ALPHA_VANTAGE_API_KEY=
